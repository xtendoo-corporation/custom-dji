<?xml version="1.0"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_sale_orderline_merge_settings">
            <field name="name">sale.orderline.merge.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='sale_management']//setting[last()]" position="after">
                    <setting string="Sale Order Merge" help="Will Automatically merge sale orderlines while creating or editing order.">
                        <field name="auto_merge_sale_orderlines"/>
                    </setting>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
