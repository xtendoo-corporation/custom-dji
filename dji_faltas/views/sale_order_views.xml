<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_dji_faltas" model="ir.ui.view">
        <field name="name">sale.order.form.dji.faltas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Botón en la cabecera del presupuesto -->
            <xpath expr="//header" position="inside">
                <button name="%(accion_gestionar_faltas)d"
                        type="action"
                        string="Gestionar faltas"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
            <!-- Columna "Falta" junto a la cantidad -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="x_cant_falta" string="Falta" optional="show" invisible="display_type"/>
            </xpath>
        </field>
    </record>
</odoo>
