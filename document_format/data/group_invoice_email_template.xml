<?xml version="1.0" ?>
<odoo>
     <!-- Mail template are declared in a NOUPDATE block
         so users can freely customize/delete them -->
    <data noupdate="1">
        <!--Email template -->
        <record id="document_format.email_template_group_invoice" model="mail.template">
            <field name="name">Factura Agrupada</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">{{ object.company_id.name }} Factura (Ref {{ object.number or 'n/a' }})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-if="object.partner_id.parent_id">
                            {{ object.partner_id.name }} ({{ object.partner_id.parent_id.name }}),
                        </t>
                        <t t-else="">
                            {{ object.partner_id.name }},
                        </t>
                        <br /><br />
                        Here is your
                        <t t-if="object.name">
                            invoice <strong>{{ object.name }}</strong>
                        </t>
                        <t t-else="">
                            invoice
                        </t>
                        <t t-if="object.invoice_origin">
                            (with reference: {{ object.invoice_origin }})
                        </t>
                        amounting in <strong t-out="format_amount(object.amount_total, object.currency_id)"/>
                        from {{ object.company_id.name }}.
                        <t t-if="object.invoice_payment_state == 'paid'">
                            This invoice is already paid.
                        </t>
                        <t t-else="">
                            Please remit payment at your earliest convenience.
                        </t>
                        <br /><br />
                        Do not hesitate to contact us if you have any questions.
                    </p>
                </div>
            </field>
            <field name="report_template" ref="document_format.report_invoice_grouped"/>
            <field name="report_name">Invoice_{{ (object.name or '').replace('/','_') }}{{ '_draft' if object.state == 'draft' else '' }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="user_signature" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>