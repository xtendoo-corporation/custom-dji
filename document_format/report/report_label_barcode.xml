<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- La etiqueta corta <report .../> ya no es valida en Odoo 19
         (RelaxNG la rechaza); convertido a record ir.actions.report -->
    <record id="action_label_barcode_report" model="ir.actions.report">
        <field name="name">Label Impresion</field>
        <field name="model">stock.picking.line.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">document_format.label_barcode_report</field>
        <field name="report_file">document_format.label_barcode_report</field>
        <field name="paperformat_id" ref="document_format.paperformat_label"/>
    </record>
</odoo>
