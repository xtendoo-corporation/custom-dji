<record id="document_format.action_report_delivery" model="ir.actions.report">
    <field name="name">Albarán de mercancía</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">document_format.report_delivery_commodity</field>
    <field name="report_file">document_format.report_delivery_commodity</field>
    <field name="attachment"/>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
</record>


    <template id="document_format.report_delivery_commodity">
        <t t-foreach="docs" t-as="o">
            <t
                t-call="document_format.report_delivery_commodity_document"
                t-lang="o.partner_id.lang"
            />
        </t>
    </template>
    <template id="document_format.report_delivery_commodity_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                <t
                    t-set="partner"
                    t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"
                />
                <div class="page">
                    <!-- Datos del documento -->
                    <!-- El <h1 style="font-size:4em;"> envolvia TODA la lista de
                         direccion (font-size:4em en cada linea) en vez de ser
                         solo un titulo grande - bug de origen, no introducido
                         en esta migracion. Sustituido por un bloque normal,
                         mismo estilo que el resto de informes del modulo. -->
                    <ul class="list-unstyled">
                        <li t-if="o.partner_id.name">
                            <span t-field="o.partner_id.name" />
                        </li>
                        <li t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street" />
                        </li>
                        <li>
                            <span
                                t-if="o.partner_id.zip"
                                t-field="o.partner_id.zip"
                            />
                            <span
                                t-if="o.partner_id.city"
                                t-field="o.partner_id.city"
                            />
,
                            <span
                                t-if="o.partner_id.state_id"
                                t-field="o.partner_id.state_id.name"
                            />
                        </li>
                        <li
                            t-if="o.partner_id.country_id and o.partner_id.country_id.name not in ['España','Spain']"
                        >
                            <span t-field="o.partner_id.country_id.name" />
                        </li>
                        <li t-if="o.partner_id.vat">
                            NIF:
                            <span t-field="o.partner_id.vat" />
                        </li>
                        <li t-if="o.partner_id.phone">
                            <i class="fa fa-phone" />
                            <span t-field="o.partner_id.phone" />
                        </li>
                    </ul>
                    <h2>
                        <span t-field="o.name" />
                    </h2>
                    <!-- Las dos columnas (Pedido / Fecha de envio) salian
                         pegadas sin separacion; añadido margin-right explicito -->
                    <div class="row mt32 mb32">
                        <div t-if="o.origin" class="col-auto" name="div_origin" style="margin-right:40px;">
                            <strong>Pedido:</strong>
                            <p t-field="o.origin" />
                        </div>
                        <div t-if="o.state" class="col-auto" name="div_sched_date">
                            <strong>Fecha de envío:</strong>
                            <t t-if="o.state == 'done'">
                                <p t-esc="o.date_done.strftime('%d/%m/%Y')" />
                            </t>
                            <t t-if="o.state != 'done'">
                                <p t-esc="o.scheduled_date.strftime('%d/%m/%Y')" />
                            </t>
                        </div>
                    </div>
                    <!-- Fin datos del documento -->
                    <p>
                        <t
                            t-if="o.backorder_ids and o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"
                        >
                            All items couldn't be shipped, the remaining ones will be shipped as soon as they become
                            available.
                        </t>
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
