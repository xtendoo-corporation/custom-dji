<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
<!--       <report-->
<!--            id="report_invoice_without_grouped"-->
<!--            string="Factura sin Agrupar"-->
<!--            model="account.move"-->
<!--            report_type="qweb-pdf"-->
<!--            name="document_format_sylonuba.report_invoice_not_grouped"-->
<!--            print_report_name="(object._get_report_base_filename())"-->
<!--        />-->

         <record id="document_format_sylonuba.report_invoice_without_grouped" model="ir.actions.report">
            <field name="name">Factura sin Agrupar</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">document_format_sylonuba.report_invoice_not_grouped</field>
            <field name="report_file">document_format_sylonuba.report_invoice_not_grouped</field>
            <!-- Movido aqui desde account_invoice_send_views.xml: mail.template.report_name
                 ya no existe en Odoo 19, el nombre del adjunto del email ahora
                 depende de print_report_name en el report enlazado -->
            <field name="print_report_name">'Invoice_%s%s' % ((object.name or '').replace('/', '_'), '_draft' if object.state == 'draft' else '')</field>
            <field name="attachment"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">list,form</field>
        </record>

        <template id="report_invoice_not_grouped">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t
                        t-call="document_format_sylonuba.report_invoice_document_xtendoo"
                    />
                </t>
            </t>
        </template>

        <template id="document_format_sylonuba.report_invoice_document_xtendoo">
            <t t-name="document_format_sylonuba.report_invoice_document_xtendoo">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Datos del Documento-->
                        <!-- Datos del movimiento -->
                        <div style="width:50%;float:left;clear:both;margin-top:5px;">
                            <ul class="list-unstyled">
                                <li>
                                    <h4 class="mt16" style="font-weight:bold;">
                                        <span t-if=" o.move_type == 'out_invoice' and o.state == 'posted'">
                                            Factura:
                                        </span>
                                        <span t-if=" o.move_type == 'out_invoice' and o.state == 'draft'">
                                            Factura Borrador:
                                        </span>
                                        <span t-if=" o.move_type == 'out_invoice' and o.state == 'cancel'">
                                            Factura Cancelada:
                                        </span>
                                        <span t-if=" o.move_type == 'out_refund'">
                                            Factura Rectificativa:
                                        </span>
                                        <span t-if=" o.move_type == 'in_refund'">
                                            Factura Rectificativa Proveedor:
                                        </span>
                                        <span t-if=" o.move_type == 'in_invoice'">
                                            Factura Proveedor:
                                        </span>
                                        <span t-if="o.name != '/'" t-field="o.name"/>
                                    </h4>
                                </li>
                                <li t-if="o.invoice_date" name="invoice_date">
                                    <strong>Fecha:</strong>
                                    <span class="m-0" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                </li>
                                <li t-if="o.invoice_origin" name="origin">
                                    <strong>Pedido:</strong>
                                    <span class="m-0" t-field="o.invoice_origin"/>
                                </li>
<li t-if="o.ref" name="reference">
                                    <strong>Referencia:</strong>
                                    <span class="m-0" t-field="o.ref"/>
                                </li>
                                <li t-if="o.invoice_payment_term_id" name="reference">
                                    <strong>Forma de Pago:</strong>
                                    <span class="m-0" t-field="o.invoice_payment_term_id"/>
                                </li>
                                <li t-if="o.invoice_user_id" name="user">
                                    <strong>Comercial:</strong>
                                    <span class="m-0" t-field="o.invoice_user_id"/>
                                </li>
                                <div class="col-auto mw-100 mb-2"
                                     t-if="o.invoice_date_due and  o.move_type == 'out_invoice' and o.state == 'posted'"
                                     name="due_date"
                                     style="display:none;">
                                    <strong>Due Date:</strong>
                                    <p class="m-0" t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
                                </div>
                            </ul>
                        </div>
                        <!-- Fin datos del movimiento -->
                        <!-- Datos del cliente -->
                        <div style="width:50%;float:left;margin-top:5px;">
                            <ul class="list-unstyled">
                                <li t-if="o.partner_id.ref">
                                    <strong>Código Cliente:</strong>
                                    <span class="m-0" t-field="o.partner_id.ref"/>
                                </li>
                                <li t-if="o.partner_id.name">
                                    <span t-field="o.partner_id.name"/>
                                </li>
                                <li t-if="o.partner_id.comercial">
                                    (<span t-field="o.partner_id.comercial"/>)
                                </li>
                                <li t-if="o.partner_id.street">
                                    <span t-field="o.partner_id.street"/>
                                </li>
                                <li>
                                    <span
                                        t-if="o.partner_id.zip"
                                        t-field="o.partner_id.zip"
                                    />
                                    <span
                                        t-if="o.partner_id.city"
                                        t-field="o.partner_id.city"
                                    />
                                    ,
                                    <span
                                        t-if="o.partner_id.state_id"
                                        t-field="o.partner_id.state_id.name"
                                    />
                                </li>
                                <li
                                    t-if="o.partner_id.country_id and o.partner_id.country_id.name not in ['España','Spain']"
                                >
                                    <span t-field="o.partner_id.country_id.name"/>
                                </li>
                                <li t-if="o.partner_id.vat">
                                    <strong>NIF:</strong>
                                    <span t-field="o.partner_id.vat"/>
                                </li>
                                <li t-if="o.reference_type == 'none' and o.payment_reference and o.payment_reference != o.name">
                                    <strong>Referencia Pago:</strong>
                                    <span t-field="o.payment_reference"/>
                                </li>
                            </ul>
                        </div>
                        <!-- Fin datos del cliente -->
                        <t
                            t-set="display_discount"
                            t-value="any([l.discount for l in o.invoice_line_ids])"
                        />
                        <table
                            class="table table-sm o_main_table"
                            name="invoice_line_table"
                            style="clear:both;"
                        >
                            <!-- Cabecera -->
                            <thead>
                                <tr>
                                    <th
                                        name="th_code"
                                        class="text-start"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:13%; font-size:0.8em; !important;"
                                    >
                                        Código
                                    </th>
                                    <th
                                        name="th_description"
                                        class="text-start"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:35%; font-size:0.8em; !important;"
                                    >
                                        Descripción
                                    </th>
                                    <th
                                        name="th_quantity"
                                        class="text-end"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                    >
                                        Unds
                                    </th>
                                    <th
                                        name="th_priceunit"
                                        class="text-end"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                    >
                                        Importe
                                    </th>
                                    <th
                                        name="th_discount"
                                        t-if="display_discount"
                                        class="text-end"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                    >
                                        Dto.%
                                    </th>
                                    <th
                                        name="th_taxes"
                                        class="text-end"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                    >
                                        IVA%
                                    </th>
                                    <th
                                        name="th_subtotal"
                                        class="text-end"
                                        style="font-weight:bold; solid; black; padding: 0px; margin: 0px; width:12%; font-size:0.8em; !important;"
                                    >
                                        <t t-if="o.company_price_include != 'tax_included'">
                                            Total
                                        </t>
                                        <t t-if="o.company_price_include == 'tax_included'">
                                            Total I.I.
                                        </t>
                                    </th>
                                </tr>
                            </thead>
                            <!-- Fin cabecera -->
                            <!-- Lineas -->
                            <tbody class="invoice_tbody">
                                <!-- Variables -->
                                <t t-set="current_subtotal" t-value="0"/>
                                <t
                                    t-set="lines"
                                    t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"
                                />
                                <!-- Fin variables -->
                                <t t-foreach="lines" t-as="line">
                                    <!-- Variables FOREACH-->
                                    <t t-if="o.company_price_include != 'tax_included'"
                                        t-set="current_subtotal"
                                        t-value="current_subtotal + line.price_subtotal"
                                    />
                                    <t t-if="o.company_price_include == 'tax_included'"
                                        t-set="current_subtotal"
                                        t-value="current_subtotal + line.price_total"
                                    />
                                    <!-- Fin variables FOREACH-->
                                    <!-- Lineas impresión-->
                                    <tr
                                        t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''"
                                    >
                                        <t
                                            t-if="line.display_type not in ('line_section', 'line_note')"
                                            name="account_invoice_line_accountable"
                                        >
                                            <td
                                                class="text-start"
                                                style="solid; black; padding: 0px; margin: 0px; width:13%; font-size:0.8em; !important;"
                                            >
                                                <span
                                                    t-field="line.product_id.default_code"
                                                />
                                            </td>
                                            <td
                                                name="account_invoice_line_name"
                                                style="solid; black; padding: 0px; margin: 0px; width:35%; font-size:0.8em; !important;"
                                            >
                                                <t
                                                    t-set="productName"
                                                    t-value="line.name or line.product_id.name or ''"
                                                />
                                                <t
                                                    t-set="name_num"
                                                    t-value="productName.find(']') + 1 "
                                                />
                                                <t
                                                    t-set="name"
                                                    t-value="productName[name_num:]"
                                                />
                                                <span
                                                    t-esc="name"
                                                    t-options="{'widget': 'text'}"
                                                />
                                            </td>
                                            <td
                                                class="text-end"
                                                style="solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                            >
                                                <t t-if=" o.move_type in ('out_refund','in_refund')">
                                                    <span>- </span>
                                                </t>
                                                <span t-field="line.quantity"/>
                                                <span
                                                    t-field="line.product_uom_id"
                                                    groups="uom.group_uom"
                                                />
                                            </td>
                                            <td
                                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                                style="solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                            >
                                                <t t-if=" o.move_type in ('out_refund','in_refund')">
                                                    <span>- </span>
                                                </t>
                                                <span
                                                    class="text-nowrap"
                                                    t-field="line.price_unit"
                                                />
                                            </td>
                                            <td
                                                t-if="display_discount"
                                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                                style="solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                            >
                                                <span
                                                    class="text-nowrap"
                                                    t-field="line.discount"
                                                />
                                            </td>
                                            <td
                                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                                style="solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                            >
                                                <span
                                                    t-esc="', '.join(map(lambda x: str(x.amount), line.tax_ids))"
                                                    id="line_tax_ids"
                                                />
                                            </td>
                                            <td
                                                class="text-end o_price_total"
                                                style="solid; black; padding: 0px; margin: 0px; width:10%; font-size:0.8em; !important;"
                                            >
                                                <t t-if=" o.move_type in ('out_refund','in_refund')">
                                                    <span>- </span>
                                                </t>
                                                <span t-if="o.company_price_include != 'tax_included'"
                                                    class="text-nowrap"
                                                    t-field="line.price_subtotal"
                                                />
                                                <span t-if="o.company_price_include == 'tax_included'"
                                                    class="text-nowrap"
                                                    t-field="line.price_total"
                                                />
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td
                                                colspan="99"
                                                style="solid; black; padding: 0px; margin: 0px; font-size:0.8em; !important;"
                                            >
                                                <span
                                                    t-field="line.name"
                                                    t-options="{'widget': 'text'}"
                                                />
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td
                                                colspan="99"
                                                style="solid; black; padding: 0px; margin: 0px; font-size:0.8em; !important;"
                                            >
                                                <span
                                                    t-field="line.name"
                                                    t-options="{'widget': 'text'}"
                                                />
                                            </td>
                                        </t>
                                    </tr>
                                    <!-- Fin lineas impresión-->
                                    <!-- Subtotal impresión -->
                                    <t
                                        t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')"
                                    >
                                        <tr class="is-subtotal text-end">
                                            <td
                                                colspan="99"
                                                style="solid; black; padding: 0px; margin: 0px; font-size:0.8em; !important;"
                                            >
                                                <strong class="mr16">Subtotal</strong>
                                                 <t t-if=" o.move_type in ('out_refund','in_refund')">
                                                    <span>- </span>
                                                </t>
                                                <span
                                                    t-esc="current_subtotal"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Fin subtotal impresión -->
                                </t>
                            </tbody>
                            <!-- Fin lineas -->
                        </table>
                        <div class="clearfix">
                             <!-- Totales documento -->
                            <div id="total" class="row">
                                <div
                                    t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                                >
                                                                   <table class="table table-sm" style="page-break-inside: avoid;">
<!-- Totales como en el 13: Subtotal, un renglon por grupo de impuestos y Total, con el signo
                                             menos en las rectificativas (el core 19 imprime una caja distinta) -->
                                        <t t-set="is_refund" t-value="o.move_type in ('out_refund', 'in_refund')"/>
                                        <tr class="border-black o_subtotal">
                                            <td style="solid; black; padding: 0px; margin: 0px; !important;">
                                                <strong>Subtotal</strong>
                                            </td>
                                            <td class="text-end" style="solid; black; padding: 0px; margin: 0px; !important;">
                                                <t t-if="is_refund"><span>- </span></t>
                                                <span t-field="o.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="tax_subtotal">
                                            <tr t-foreach="tax_subtotal.get('tax_groups', [])" t-as="tax_group" style="solid; black; padding: 0px; margin: 0px; !important;">
                                                <td style="solid; black; padding: 0px; margin: 0px; !important;">
                                                    <span class="text-nowrap" t-esc="tax_group['group_name']"/>
                                                </td>
                                                <td class="text-end o_price_total" style="solid; black; padding: 0px; margin: 0px; !important;">
                                                    <t t-if="is_refund"><span>- </span></t>
                                                    <span class="text-nowrap" t-esc="tax_group['tax_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr class="border-black o_total">
                                            <td style="solid; black; padding: 0px; margin: 0px; !important;">
                                                <strong>Total</strong>
                                            </td>
                                            <td class="text-end" style="solid; black; padding: 0px; margin: 0px; !important;">
                                                <strong>
                                                    <t t-if="is_refund"><span>- </span></t>
                                                    <span class="text-nowrap" t-field="o.amount_total"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <!-- Fin totales documento -->
                            <!-- Desglose de vencimientos -->
                            <t t-set="due_list" t-value="[d for d in o.get_multi_due_list() if d[2] and o.move_type not in ('out_refund', 'in_refund')]"/>
                            <t t-if="due_list">
                                <div id="duelist" class="row">
                                    <div
                                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                                    >
                                        <table
                                            class="table table-sm"
                                            style="page-break-inside: avoid;font-size:0.9em;"
                                        >
                                            <tr>
                                                <td
                                                    style="solid; black; padding: 0px; margin: 0px; !important;"
                                                >
                                                    <b>Fecha de vencimiento</b>
                                                </td>
                                                <td
                                                    style="solid; black; padding: 0px; margin: 0px; !important;"
                                                    class="text-end"
                                                >
                                                    <b>Importe</b>
                                                </td>
                                            </tr>
                                            <tr t-foreach="due_list" t-as="due_tuple">
                                                <td
                                                    style="solid; black; padding: 0px; margin: 0px; !important;"
                                                >
                                                    <span
                                                        t-esc="due_tuple[0]"
                                                        t-options="{'widget': 'date'}"
                                                    />
                                                </td>
                                                <td
                                                    class="text-end"
                                                    style="solid; black; padding: 0px; margin: 0px; !important;"
                                                >
                                                    <span
                                                        t-esc="due_tuple[1]"
                                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                    />
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </t>
                            <!-- Fin desglose de vencimientos -->
                        </div>
                        <div style="clear:both;"/>
                        <p t-if="o.narration" name="comment">
                            <span t-field="o.narration"/>
                        </p>
                        <p t-if="o.invoice_payment_term_id" name="payment_term">
                            <span t-field="o.invoice_payment_term_id.note"/>
                        </p>
                        <p
                            t-if="o.fiscal_position_id.note"
                            name="note"
                            style="display:none;"
                        >
                            <span t-field="o.fiscal_position_id.note"/>
                        </p>
                        <div
                            id="qrcode"
                            t-if="o.display_qr_code and o.amount_residual"
                            style="display:none;"
                        >
                            <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                            <p t-if="qr_code_url">
                                <strong class="text-center">Scan me with your banking app.</strong>
                                <br/>
                                <br/>
                                <img class="border border-dark rounded" t-att-src="qr_code_url"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
