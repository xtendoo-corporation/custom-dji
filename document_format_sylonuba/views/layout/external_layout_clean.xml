<?xml version="1.0" ?>
<odoo>
    <data>
        <template
            id="document_format_sylonuba.external_layout_clean_xtendoo"
            inherit_id="web.external_layout_bold"
        >
            <!-- web.external_layout_bold ya no tiene la clase o_clean_header en
                 Odoo 19 (el div de cabecera ahora usa t-attf-class dinamico);
                 se retargetea por el atributo t-att-style="report_header_style",
                 unico dentro de la plantilla, para localizar el mismo div. -->
            <xpath expr="//div[@t-att-style='report_header_style']" position="replace">
                <!-- Odoo extrae la cabecera del PDF buscando un div cuya clase
                     contenga el TOKEN exacto "header" (ir_actions_report.py,
                     _prepare_html: match_klass sobre 'header'/'footer'/'article').
                     Sin ese token el bloque se descarta en silencio del PDF
                     aunque se vea bien en el HTML - por eso se mantiene aqui,
                     igual que el div original que se sustituyo. -->
                <div class="header o_clean_header">
                    <div class="row">
                        <div class="col-6">
                            <!-- 200px (~53mm) ocupaba casi todo el margin_top del
                                 paperformat (52mm), solapando con el titulo del
                                 documento; reducido para que quepa con margen -->
                            <img
                                t-if="company.logo"
                                t-att-src="image_data_uri(company.logo)"
                                alt="Logo"
                                style="max-height:84px"
                            />
                        </div>
                        <div class="col-5 offset-1" name="company_address">
                            <ul class="list-unstyled">
                                <strong>
                                    <li t-if="company.name">
                                        <span t-field="company.name" />
                                    </li>
                                </strong>
                                <li t-if="company.street">
                                    <span t-field="company.street" />
                                </li>
                                <li t-if="company.street2">
                                    <span t-field="company.street2" />
                                </li>
                                <li>
                                    <span t-if="company.city" t-field="company.city" />
                                    , <span t-if="company.zip" t-field="company.zip" />
                                     <span t-if="company.state_id" t-field="company.state_id" />
                                </li>
                                <li t-if="company.vat">
                                    <t t-esc="company.country_id.vat_label or 'Tax ID'"/>
                                    <span t-field="company.vat" />
                                </li>
                                <!-- El bloque "Descarga: C/ Olivo,7" (solo para
                                     compras, via is_purchase) se ha movido al
                                     cuerpo de purchase.xml: al vivir aqui la
                                     cabecera cambiaba de altura segun el tipo de
                                     documento y en compras se solapaba con el
                                     titulo (2 lineas extra no cabian en el
                                     margin_top de 52mm ya ajustado para 7 lineas) -->
                            </ul>
                        </div>
                    </div>
                    <div
                        style="height:2px;width:100%;background-color:black;margin-top:2px;"
                    >
                    </div>
                </div>
            </xpath>
            <!-- Pie como en el 13: pie de la compañía a la izquierda (no en compras), email y teléfono a la
                 derecha, página/total en caja negra, y debajo el lema y el registro mercantil -->
            <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
                <div class="o_footer_content row border-top pt-2">
                    <div class="col-6">
                        <t t-if="not is_purchase">
                            <span t-field="company.report_footer"/>
                        </t>
                    </div>
                    <div class="col-4 text-end">
                        <div t-if="company.phone"><span t-field="company.phone"/></div>
                        <div t-if="company.email"><span t-field="company.email"/></div>
                    </div>
                    <div class="col-2 text-end">
                        <span t-if="report_type == 'pdf'"
                              style="background-color:black; color:white; font-weight:bold; padding:2px 8px; white-space:nowrap;">
                            <span class="page"/> / <span class="topage"/>
                        </span>
                    </div>
                </div>
                <div t-if="not is_html_empty(company.report_header)" class="text-start" style="font-size: 10px;">
                    <span t-field="company.report_header"/>
                </div>
                <div t-if="company.company_registry" class="text-start" style="font-size: 10px;">
                    <span t-field="company.company_registry"/>
                </div>
            </xpath>
