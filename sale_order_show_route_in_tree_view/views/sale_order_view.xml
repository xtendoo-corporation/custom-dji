<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--margin-->
        <record id="saleorder_form_ihnerit_margins" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.margins</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="route_ids" widget="many2many_tags" optional="show"/>
                </xpath>
                <!-- v19 core quito editable="bottom" que si tenia v15 en esta
                     lista - sin eso no se puede editar en linea ni
                     seleccionar varios presupuestos para cambiar un campo a
                     la vez (ruta, fecha de entrega, etc). Restaurado a
                     peticion del cliente. -->
                <xpath expr="//list" position="attributes">
                    <attribute name="editable">bottom</attribute>
                    <!-- 'multi_edit' es un atributo APARTE de 'editable' en
                         v19 (list_arch_parser.js), no implicito - sin el,
                         seleccionar varios presupuestos y editar un campo
                         no ofrece aplicarlo a todos, aunque la lista ya sea
                         editable en linea para un solo registro. -->
                    <attribute name="multi_edit">1</attribute>
                    <!-- GOTCHA REAL v19: con editable="bottom" el clic en
                         una fila entra en edicion inline en vez de abrir el
                         presupuesto (a diferencia de v15, donde la lista NO
                         era editable y el clic siempre abria el formulario).
                         'open_form_view' es el atributo oficial (ver
                         list_renderer.js: hasOpenFormViewButton = editable
                         ? archInfo.openFormView : false) que añade una
                         columna con un icono para abrir el formulario sin
                         perder la edicion en linea/multi-edicion. -->
                    <attribute name="open_form_view">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
