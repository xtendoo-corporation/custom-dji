<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--margin-->
        <record id="saleorder_form_ihnerit_margins" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.margins</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="route_ids" widget="many2many_tags" optional="show"/>
                </xpath>
                <!-- v19 core quito editable="bottom" que si tenia v15 en esta
                     lista. PRIMER INTENTO (revertido): restaurar
                     editable="bottom" + open_form_view="1" - funcionaba pero
                     rompia la experiencia normal de clic para abrir el
                     presupuesto (habia que usar un icono aparte), distinto
                     de como lo hace el propio Odoo en listas nativas con
                     multi-edicion real (ir.ui.view de account.analytic.account
                     "Analytic Accounts", payment.method "Payment Methods"):
                     esas NO llevan editable, solo multi_edit="1" - el clic
                     normal (sin seleccion) sigue abriendo el formulario
                     exactamente igual que antes (ver onCellClicked en
                     list_renderer.js: sin editable, isInlineEditable()
                     devuelve false y sin seleccion cae directo a
                     openRecord()); la edicion multiple solo se activa
                     cuando ya hay varias filas seleccionadas con las
                     casillas. Ese es el patron correcto, replicado aqui. -->
                <xpath expr="//list" position="attributes">
                    <attribute name="multi_edit">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
