<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.over.processed</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="has_overprocessed_moves" invisible="1"/>
                <button
                    name="action_update_sale_order"
                    class="btn-primary"
                    string="Update Sale Order"
                    groups="stock.group_stock_manager"
                    type="object"
                    invisible="not has_overprocessed_moves"
                />
            </header>
        </field>
    </record>
</odoo>
